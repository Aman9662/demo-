# ── ChetnaSync Environment Variables ──────────────────────────
# Copy this file to .env and fill in values before starting.

# REQUIRED — Admin credentials for the responder dashboard
ADMIN_USERNAME=aman
ADMIN_PASSWORD=00000000

# REQUIRED — Twilio auth token for SMS webhook signature verification
TWILIO_AUTH_TOKEN=

# OPTIONAL — OpenRouteService API key for avoidance routing
ORS_API_KEY=

# OPTIONAL — Server port (default: 3000)
PORT=3000

# OPTIONAL — Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# OPTIONAL — SMS gateway number shown to citizens (E.164 format)
SMS_NUMBER=

# OPTIONAL — Data retention window in hours (default: 72)
RETENTION_HOURS=72
